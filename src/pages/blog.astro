---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getPostDate } from "../lib/blog";
import Layout from "../layouts/Layout.astro";

type BlogEntry = CollectionEntry<"blog">;

const entries = await getCollection("blog");
const rendered = await Promise.all(
	entries.map(async (entry: BlogEntry) => {
		const { Content } = await render(entry);
		const date = getPostDate(entry);
		const title =
			entry.data.title ||
			entry.body?.match(/^#\s+(.*)/m)?.[1] ||
			"Untitled Post";
		return { entry, Content, date, title };
	}),
);
rendered.sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout title="patrick hulin's internet blog" ogTitle="patrick's blog">
  <style is:global>
    h1 {
      text-transform: lowercase;
      margin-bottom: 3rem;
    }
    article h1 {
      margin-bottom: 1rem;
    }
    h2 {
      font-family: "Fraunces", "Times New Roman", serif;
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
      text-transform: lowercase;
    }
    h3 {
      margin-bottom: 0.5rem;
      text-transform: lowercase;
    }
    article img {
      display: block;
      margin: 0;
      width: 60%;
      max-width: 100%;
      height: auto;
      border-radius: 12px;
    }
  </style>
  <center><h1>patrick's internet blog</h1></center>
  {
    rendered.map(({ entry, Content, date }) => (
      <article id={entry.id}>
        <a href={`/blog/${entry.id}`}>
          <h3>
            <time datetime={date.toISOString()}>
              {date.toLocaleString("en-US", { weekday: "long", year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" })}
            </time>
          </h3>
        </a>
        <Content />
      </article>
    ))
  }
</Layout>
