---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getPostDate } from "../../lib/blog";
import Layout from "../../layouts/Layout.astro";

type BlogEntry = CollectionEntry<"blog">;

export async function getStaticPaths() {
	const entries = await getCollection("blog");
	return entries.map((entry: BlogEntry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props as { entry: BlogEntry };
const { Content } = await render(entry);
const date = getPostDate(entry);
const title =
	entry.data.title || entry.body?.match(/^#\s+(.*)/m)?.[1] || "Untitled Post";
const description =
	entry.data.description ?? "A post from Patrick Hulin's internet blog.";
const ogImage = entry.data.cover?.src ?? "/assets/og-image.png";
const ogImageWidth = entry.data.cover?.width ?? 1200;
const ogImageHeight = entry.data.cover?.height ?? 630;
---

<Layout
  title={`${title} — patrick hulin's internet blog`}
  ogTitle={title}
  description={description}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogType="article"
>
  <style is:global>
    h1 {
      text-transform: lowercase;
      margin-bottom: 3rem;
    }
    article h1 {
      margin-bottom: 1rem;
    }
    h2 {
      font-family: "Fraunces", "Times New Roman", serif;
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
      text-transform: lowercase;
    }
    h3 {
      margin-bottom: 0.5rem;
      text-transform: lowercase;
    }
    article img {
      display: block;
      margin: 0;
      width: 60%;
      max-width: 100%;
      height: auto;
      border-radius: 12px;
    }
    .blog-header-link {
      border: 0;
      color: inherit;
    }
  </style>
  <center>
    <h1><a href="/blog" class="blog-header-link">patrick's internet blog</a></h1>
  </center>
  <article id={entry.id}>
    <a href={`/blog/${entry.id}`}>
      <h3>
        <time datetime={date.toISOString()}>
          {date.toLocaleString("en-US", { weekday: "long", year: "numeric", month: "long", day: "numeric", hour: "numeric", minute: "2-digit" })}
        </time>
      </h3>
    </a>
    <Content />
  </article>
</Layout>
